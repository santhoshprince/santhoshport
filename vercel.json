{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "public/santhoshkumar1.pdf", "use": "@vercel/static" },
    { "src": "public/manus-storage/santhoshkumar1.pdf", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/manus-storage/(.*)", "dest": "/public/manus-storage/$1" }
  ]
}
